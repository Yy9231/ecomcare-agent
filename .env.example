DATABASE_URL=postgresql+asyncpg://ecomcare:ecomcare@localhost:5432/ecomcare
CHECKPOINT_DATABASE_URL=postgresql://ecomcare:ecomcare@localhost:5432/ecomcare
JWT_SECRET=change-this-in-production
# 生产环境必须设置且保持稳定；修改后，已保存的账号 API Key 将无法解密。
MODEL_CREDENTIALS_SECRET=change-this-model-credentials-secret
# 公开部署设为 true 后，所有账号只能使用规则模式且不能保存外部模型配置。
PUBLIC_DEMO_MODE=false
MODEL_ENABLED=false
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=gpt-4.1-mini
# 可选：额外供应商配置。值为单行 JSON，密钥仅由后端读取。
# MODEL_PROVIDER_CONFIGS={"deepseek":{"api_key":"your-key","model":"deepseek-chat"},"ollama":{"model":"qwen3:8b","base_url":"http://host.docker.internal:11434"}}
MODEL_PROVIDER_CONFIGS=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173
